@page "/account/logout"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

@using EmpPortal.Application.Identity
@using EmpPortal.Web.Components.Account
@using Microsoft.AspNetCore.Authorization

@inject IPortalSignOutService PortalSignOutService
@inject IdentityRedirectManager RedirectManager

<PageTitle>خروج | پرتال کارمندی</PageTitle>

<section class="welcome" aria-labelledby="logout-title">
    <span class="eyebrow">خروج امن</span>
    <h1 id="logout-title">خروج از حساب کاربری</h1>
    <p>با خروج از پرتال، حساب Windows شما بدون تغییر باقی می‌ماند.</p>

    <EditForm Model="Input"
              method="post"
              OnValidSubmit="SignOutAsync"
              FormName="portal-logout"
              data-auto-submit="@Confirmed.ToString().ToLowerInvariant()"
              data-static-submit-loading="true"
              Enhance="false">
        @if (Confirmed)
        {
            <p role="status">در حال پایان‌دادن امن به نشست پرتال…</p>
        }
        <button class="submit-button @(Confirmed ? "visually-hidden" : null)"
                type="submit"
                data-confirm-submit
                data-confirm-title="خروج از حساب کاربری؟"
                data-confirm-text="فقط نشست پرتال بسته می‌شود و حساب Windows شما بدون تغییر باقی می‌ماند."
                data-confirm-button-text="بله، خارج شو"
                data-loading-text="در حال خروج امن…">خروج از پرتال</button>
    </EditForm>
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "portal-logout")]
    private LogoutInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private bool Confirmed { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new LogoutInput();
    }

    private async Task SignOutAsync()
    {
        string? sessionIdValue = HttpContext.User.FindFirst("sid")?.Value;
        Guid? sessionId = Guid.TryParse(sessionIdValue, out Guid parsedSessionId)
            ? parsedSessionId
            : null;

        await PortalSignOutService.SignOutAsync(sessionId, HttpContext.RequestAborted);
        RedirectManager.RedirectTo("account/login");
    }

    private sealed class LogoutInput
    {
    }
}
