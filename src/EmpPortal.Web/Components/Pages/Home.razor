@page "/"
@attribute [Authorize]
@implements IDisposable

@using EmpPortal.Application.Authorization
@using EmpPortal.Application.Configuration
@using EmpPortal.Application.Forms
@using EmpPortal.Application.Localization
@using EmpPortal.Web.Security
@using EmpPortal.Web.Services
@using Microsoft.AspNetCore.Authorization

@inject IConfiguration Configuration
@inject IRuntimeSettingsService RuntimeSettings
@inject IFormSubmissionService FormSubmissionService
@inject FormActorFactory ActorFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>داشبورد | @PortalTitle</PageTitle>

<section class="dashboard-page" aria-labelledby="dashboard-title">
    <header class="dashboard-heading">
        <div>
            <span class="eyebrow">داشبورد</span>
            <h1 id="dashboard-title">سلام @displayName</h1>
        </div>
        <div class="today-chip">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" /></svg>
            <span><small>امروز</small><strong>@todayText</strong></span>
            <span class="today-clock">
                <small>ساعت</small>
                <strong dir="ltr">@clockText</strong>
            </span>
        </div>
    </header>

    <div class="metrics-grid" aria-label="خلاصه وضعیت">
        <article class="metric-card blue">
            <span class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" /></svg></span>
            <div><small>رویدادهای فعال</small><strong>@FormatMetric(availableForms.Count)</strong></div>
        </article>
        <article class="metric-card violet">
            <span class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4V5Zm4 4h8M8 13h5" /></svg></span>
            <div><small>ثبت‌های من</small><strong>@FormatMetric(availableForms.Sum(form => form.SubmissionCount))</strong></div>
        </article>
        <article class="metric-card green">
            <span class="metric-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></span>
            <div><small>نشست</small><strong>فعال</strong></div>
        </article>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="dashboard-alert" role="alert">@errorMessage</div>
    }

    <section class="dashboard-card services-card" aria-labelledby="services-title">
        <header>
            <div>
                <h2 id="services-title">میانبر خدمات</h2>
            </div>
        </header>
        <div class="service-tile-grid">
            @foreach (PortalServiceDefinition item in PortalServiceCatalog.All.Where(service => service.IsAvailable))
            {
                string href = ResolveServiceHref(item);
                bool external = item.OpensInNewTab && !string.IsNullOrWhiteSpace(foodReservationUrl) &&
                    string.Equals(item.Key, PortalServiceCatalog.FoodKey, StringComparison.OrdinalIgnoreCase);
                <a class="service-tile tone-@item.Tone.ToString().ToLowerInvariant()"
                   href="@href"
                   target="@(external ? "_blank" : null)"
                   rel="@(external ? "noopener noreferrer" : null)">
                    <span class="service-tile-icon" aria-hidden="true"><PortalServiceIcon ServiceKey="@item.Key" /></span>
                    <strong>@item.Title</strong>
                </a>
            }
        </div>
    </section>

    <div class="dashboard-grid">
        <section class="dashboard-card forms-card">
            <header>
                <div>
                    <h2>رویدادهای اخیر</h2>
                </div>
                <a href="/forms">همه</a>
            </header>
            @if (isLoading)
            {
                <div class="dashboard-loading"><span></span><span></span><span></span></div>
            }
            else if (availableForms.Count == 0)
            {
                <div class="mini-empty"><strong>رویداد فعالی نیست</strong></div>
            }
            else
            {
                <div class="form-shortcuts">
                    @foreach (FormSummary form in availableForms.Take(4))
                    {
                        <a href="@($"/forms/{form.Slug}")"><span>ر</span><div><strong>@form.Title</strong></div><b>شروع</b></a>
                    }
                </div>
            }
        </section>

        <aside class="dashboard-card essentials-card">
            <header><div><h2>دسترسی سریع</h2></div></header>
            <ul>
                <li><span class="status-dot"></span><div><strong>@userUpn</strong></div></li>
            </ul>
            <a class="essential-link" href="/forms">ثبت‌نام‌ها ←</a>
            <AuthorizeView Roles="@PortalRoles.FormManagementRoles" Context="formManagerState">
                <a class="essential-link admin" href="/admin/forms">مدیریت فرم‌ها ←</a>
            </AuthorizeView>
        </aside>
    </div>
</section>

@code {
    private IReadOnlyList<FormSummary> availableForms = [];
    private bool isLoading = true;
    private string? errorMessage;
    private string displayName = "همکار گرامی";
    private string userUpn = string.Empty;
    private string? foodReservationUrl;
    private string todayText = PersianDateTimeFormatter.FormatDate(DateTimeOffset.Now);
    private string clockText = PersianDateTimeFormatter.FormatClock(DateTimeOffset.Now);
    private PeriodicTimer? clockTimer;
    private readonly CancellationTokenSource clockCts = new();
    private string PortalTitle => Configuration["Portal:Title"] ?? "پرتال کارمندی";

    protected override async Task OnInitializedAsync()
    {
        RefreshClock();
        _ = RunClockAsync();
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        displayName = state.User.FindFirst("display_name")?.Value ?? state.User.Identity?.Name ?? "همکار گرامی";
        userUpn = state.User.Identity?.Name ?? "حساب سازمانی";
        foodReservationUrl = await RuntimeSettings.GetValueAsync(PortalRuntimeSettingKeys.FoodReservationExternalUrl);

        try
        {
            availableForms = await FormSubmissionService.GetAvailableFormsAsync(await ActorFactory.CreateAsync());
        }
        catch (Exception exception) when (exception is UnauthorizedAccessException or InvalidOperationException)
        {
            errorMessage = "دریافت فهرست رویدادها ممکن نیست.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string ResolveServiceHref(PortalServiceDefinition item)
    {
        if (string.Equals(item.Key, PortalServiceCatalog.FoodKey, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(foodReservationUrl))
        {
            return foodReservationUrl;
        }

        return item.Href;
    }

    private string FormatMetric(long value) => isLoading
        ? "…"
        : PersianDateTimeFormatter.ToPersianDigits(value.ToString());

    private void RefreshClock()
    {
        DateTimeOffset now = DateTimeOffset.Now;
        todayText = PersianDateTimeFormatter.FormatDate(now);
        clockText = PersianDateTimeFormatter.FormatClock(now);
    }

    private async Task RunClockAsync()
    {
        clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await clockTimer.WaitForNextTickAsync(clockCts.Token))
            {
                RefreshClock();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        clockCts.Cancel();
        clockTimer?.Dispose();
        clockCts.Dispose();
    }
}
