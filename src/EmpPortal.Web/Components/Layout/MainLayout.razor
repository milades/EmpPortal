@inherits LayoutComponentBase
@using EmpPortal.Application.Authorization
@using EmpPortal.Application.Configuration
@inject IConfiguration Configuration
@inject IRuntimeSettingsService RuntimeSettings
@inject EmpPortal.Web.Services.IConfirmationService ConfirmationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JavaScript
@inject EmpPortal.Web.Security.PortalActorFactory ActorFactory
@inject IPortalAccessEvaluator AccessEvaluator

<AuthorizeView>
    <Authorized Context="authenticationState">
        <div class="ta-app-shell @(sidebarOpen ? "sidebar-open" : null)">
            <button type="button" class="sidebar-overlay" aria-label="بستن منو" @onclick="CloseSidebar"></button>

            <aside class="ta-sidebar" aria-label="منوی اصلی">
                <div class="sidebar-brand-row">
                    <a class="sidebar-brand" href="/" @onclick="CloseSidebar">
                        @if (!string.IsNullOrWhiteSpace(brandMark))
                        {
                            <span class="brand-mark" aria-hidden="true">@brandMark</span>
                        }
                        <span><strong>@PortalTitle</strong>@* <small>سامانه خدمات سازمانی</small> *@</span>
                    </a>
                    <button type="button" class="sidebar-close" aria-label="بستن منو" @onclick="CloseSidebar">×</button>
                </div>

                <nav class="sidebar-navigation">
                    @if (Has(PortalResources.Dashboard))
                    {
                        <span class="menu-caption">پرتال</span>
                        <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" /></svg>
                            <span>داشبورد</span>
                        </NavLink>
                    }

                    @if (HasAny(PortalResources.PersonnelView, PortalResources.PayslipView, PortalResources.PayslipSettings, PortalResources.BenefitsView))
                    {
                        <span class="menu-caption">منابع انسانی</span>
                        @if (Has(PortalResources.PersonnelView))
                        {
                            <NavLink href="/services/personnel" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-7 9a7 7 0 0 1 14 0" /></svg>
                                <span>پرونده پرسنلی</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.PayslipView))
                        {
                            <NavLink href="/services/payslip" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2V5a2 2 0 0 1 2-2Z" /><path d="M9 8h6M9 12h6" /></svg>
                                <span>فیش حقوقی من</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.PayslipSettings))
                        {
                            <NavLink href="/services/payslip-settings" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" /><path d="M4 12h2M18 12h2M12 4v2M12 18v2" /></svg>
                                <span>تنظیمات فیش حقوقی</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.BenefitsView))
                        {
                            <NavLink href="/services/benefits" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M7 7.5c0-1.5 1.8-2.5 5-2.5s5 1 5 2.5-1.8 2.5-5 2.5-5 1-5 2.5 1.8 2.5 5 2.5 5-1 5-2.5" /></svg>
                                <span>تسهیلات من</span>
                            </NavLink>
                        }
                    }

                    @if (HasAny(PortalResources.FormsEvents, PortalResources.FoodView, PortalResources.AssetsView, PortalResources.CharityView, PortalResources.CharityManage))
                    {
                        <span class="menu-caption">خدمات کارکنان</span>
                        @if (Has(PortalResources.FormsEvents))
                        {
                            <NavLink href="/forms" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M6 5h12a1 1 0 0 1 1 1v13H5V6a1 1 0 0 1 1-1Z" /></svg>
                                <span>ثبت‌نام‌ها و رویدادها</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.FoodView))
                        {
                            @if (!string.IsNullOrWhiteSpace(foodReservationUrl))
                            {
                                <a class="sidebar-external-link"
                                   href="@foodReservationUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   @onclick="CloseSidebar">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v2a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6v-2Z" /><path d="M8 11V5M12 11V3M16 11V6" /></svg>
                                    <span>رزرو غذا</span>
                                </a>
                            }
                            else
                            {
                                <NavLink href="/services/food" @onclick="CloseSidebar">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v2a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6v-2Z" /><path d="M8 11V5M12 11V3M16 11V6" /></svg>
                                    <span>رزرو غذا</span>
                                </NavLink>
                            }
                        }
                        @if (Has(PortalResources.AssetsView))
                        {
                            <NavLink href="/services/assets" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5v-7Z" /><path d="M12 12v8M4 8.5l8 3.5 8-3.5" /></svg>
                                <span>اموال من</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.CharityView))
                        {
                            <NavLink href="/services/charity" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z" /></svg>
                                <span>انفاق</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.CharityManage))
                        {
                            <NavLink href="/services/charity-admin" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v4H4V5Zm0 7h16v7H4v-7Zm4 2.5h8" /></svg>
                                <span>مدیریت انفاق</span>
                            </NavLink>
                        }
                    }

                    @if (Has(PortalResources.FormsAdmin))
                    {
                        <span class="menu-caption">مدیریت فرم‌ها</span>
                        <NavLink href="/admin/forms" @onclick="CloseSidebar">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Zm4 3h8M8 12h5M8 16h8" /></svg>
                            <span>مدیریت و گزارش فرم‌ها</span>
                        </NavLink>
                    }

                    @if (HasAny(PortalResources.AccessManage, PortalResources.RuntimeSettings))
                    {
                        <span class="menu-caption">سامانه</span>
                        @if (Has(PortalResources.AccessManage))
                        {
                            <NavLink href="/admin/access" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-7 9a7 7 0 0 1 14 0" /><path d="M19 8v4M17 10h4" /></svg>
                                <span>مدیریت دسترسی‌ها</span>
                            </NavLink>
                        }
                        @if (Has(PortalResources.RuntimeSettings))
                        {
                            <NavLink href="/admin/settings" @onclick="CloseSidebar">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.4-3.5a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.4 1a8 8 0 0 0-1.7-1L15 3.5h-4L10.6 6a8 8 0 0 0-1.7 1l-2.4-1-2 3.4 2 1.5a7 7 0 0 0 0 2.1l-2 1.5 2 3.4 2.4-1a8 8 0 0 0 1.7 1l.4 2.6h4l.4-2.6a8 8 0 0 0 1.7-1l2.4 1 2-3.4-2-1.5a7 7 0 0 0 .1-1Z" /></svg>
                                <span>تنظیمات عملیاتی</span>
                            </NavLink>
                        }
                    }
                </nav>

                <div class="sidebar-footer">
                    <div class="environment-card">
                        <span class="environment-dot"></span>
                        <div><strong>سرویس پرتال فعال است</strong><small>شبکه داخلی سازمان</small></div>
                    </div>
                </div>
            </aside>

            <div class="ta-main-column">
                <header class="ta-topbar">
                    <div class="topbar-leading">
                        <button type="button" class="menu-toggle" aria-label="باز کردن منو" @onclick="OpenSidebar">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                        </button>
                        <div><strong>فضای کاری پرتال</strong><small>خدمات یکپارچه کارکنان</small></div>
                    </div>
                    <div class="topbar-user">
                        <div class="user-copy"><strong>@GetDisplayName(authenticationState.User)</strong><small>@authenticationState.User.Identity?.Name</small></div>
                        <span class="user-avatar" aria-hidden="true">@GetInitial(authenticationState.User)</span>
                        <button type="button" class="logout-link" disabled="@isConfirmingLogout" aria-label="خروج از پرتال" @onclick="ConfirmLogoutAsync">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M15 8l4 4-4 4M8 12h11" /></svg>
                            <span>خروج</span>
                        </button>
                    </div>
                </header>

                <main class="ta-page-shell">
                    @Body
                </main>
            </div>

            <InteractiveSessionGuard />
        </div>
    </Authorized>
    <NotAuthorized>
        <main class="auth-page-shell">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    خطایی در اجرای برنامه رخ داده است.
    <a href="." class="reload">بارگذاری مجدد</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool sidebarOpen;
    private bool isConfirmingLogout;
    private IReadOnlySet<string> grantedResources = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private string? foodReservationUrl;
    private string? brandMark;
    private string PortalTitle => Configuration["Portal:Title"] ?? "پرتال کارمندی";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            brandMark = await RuntimeSettings.GetValueAsync(PortalRuntimeSettingKeys.BrandMark) ?? "اِ";
            PortalActor actor = await ActorFactory.CreateAsync();
            await AccessEvaluator.EnsureDefaultsAsync();
            grantedResources = await AccessEvaluator.GetGrantedResourceKeysAsync(actor);
            if (Has(PortalResources.FoodView))
            {
                foodReservationUrl = await RuntimeSettings.GetValueAsync(
                    PortalRuntimeSettingKeys.FoodReservationExternalUrl);
            }
        }
        catch (UnauthorizedAccessException)
        {
            grantedResources = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private bool Has(string resourceKey) => grantedResources.Contains(resourceKey);

    private bool HasAny(params string[] resourceKeys) => resourceKeys.Any(Has);

    private void OpenSidebar() => sidebarOpen = true;
    private void CloseSidebar() => sidebarOpen = false;

    private async Task ConfirmLogoutAsync()
    {
        if (isConfirmingLogout) return;
        isConfirmingLogout = true;
        try
        {
            bool confirmed = await ConfirmationService.ConfirmAsync(
                "خروج از حساب کاربری؟",
                "فقط نشست پرتال بسته می‌شود و حساب Windows شما بدون تغییر باقی می‌ماند.",
                "بله، خارج شو");
            if (confirmed)
            {
                try
                {
                    await JavaScript.InvokeVoidAsync("empPortalAuth.clear");
                }
                catch (JSException)
                {
                    // A full navigation to the logout page clears localStorage as a fallback.
                }
                NavigationManager.NavigateTo("/account/logout?confirmed=true", forceLoad: true);
            }
        }
        finally
        {
            isConfirmingLogout = false;
        }
    }

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("display_name")?.Value ?? user.Identity?.Name ?? "کاربر پرتال";

    private static string GetInitial(System.Security.Claims.ClaimsPrincipal user)
    {
        string value = GetDisplayName(user).Trim();
        return value.Length == 0 ? "ک" : value[..1];
    }
}
