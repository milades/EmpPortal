<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" lang="fa" dir="rtl" aria-label="وضعیت ارتباط با پرتال" data-nosnippet>
    <div class="components-reconnect-container" role="status" aria-live="assertive">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible reconnect-title">
            در حال اتصال مجدد به پرتال…
        </p>
        <p class="components-reconnect-repeated-attempt-visible reconnect-message">
            اتصال برقرار نشد؛ تلاش بعدی تا
            <strong><span id="components-seconds-to-next-attempt"></span> ثانیه دیگر</strong>
            انجام می‌شود.
        </p>
        <p class="components-reconnect-failed-visible reconnect-message">
            اتصال به پرتال برقرار نشد.<br />لطفاً دوباره تلاش کنید یا صفحه را بازآوری کنید.
        </p>
        <button type="button" id="components-reconnect-button" class="components-reconnect-failed-visible">
            تلاش مجدد
        </button>
        <p class="components-pause-visible reconnect-message">
            نشست شما موقتاً توسط سرور متوقف شده است.
        </p>
        <p class="components-resume-failed-visible reconnect-message">
            ادامه نشست ممکن نشد.<br />لطفاً دوباره تلاش کنید یا صفحه را بازآوری کنید.
        </p>
        <button type="button" id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            ادامه نشست
        </button>
    </div>
</dialog>
