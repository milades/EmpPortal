@using Microsoft.AspNetCore.Components.Web

<div class="searchable-select @CssClass"
     @onfocusin="OnFocusIn"
     @onfocusout="OnFocusOutAsync">
    <button type="button"
            class="searchable-select-trigger polished-input"
            disabled="@Disabled"
            aria-haspopup="listbox"
            aria-expanded="@isOpen"
            @onclick="ToggleAsync">
        <span class="@(string.IsNullOrWhiteSpace(SelectedText) ? "is-placeholder" : null)">
            @(string.IsNullOrWhiteSpace(SelectedText) ? Placeholder : SelectedText)
        </span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>

    @if (isOpen)
    {
        <div class="searchable-select-panel" role="listbox" @onmousedown:preventDefault="true">
            <input class="searchable-select-search polished-input"
                   placeholder="جستجو…"
                   value="@search"
                   @ref="searchInput"
                   @oninput="OnSearch"
                   @onclick:stopPropagation="true" />
            <div class="searchable-select-options">
                @if (FilteredOptions.Count == 0)
                {
                    <div class="searchable-select-empty">موردی یافت نشد</div>
                }
                else
                {
                    @foreach (SearchableSelectOption option in FilteredOptions)
                    {
                        <button type="button"
                                class="searchable-select-option @(string.Equals(option.Value, Value, StringComparison.Ordinal) ? "is-active" : null)"
                                role="option"
                                @onclick="() => SelectAsync(option.Value)">
                            @option.Text
                        </button>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<SearchableSelectOption> Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = "انتخاب کنید";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool isOpen;
    private bool retainFocus;
    private string search = string.Empty;
    private ElementReference searchInput;

    private string? SelectedText =>
        Options.FirstOrDefault(option => string.Equals(option.Value, Value, StringComparison.Ordinal))?.Text;

    private IReadOnlyList<SearchableSelectOption> FilteredOptions
    {
        get
        {
            if (string.IsNullOrWhiteSpace(search))
            {
                return Options;
            }

            string term = search.Trim();
            return Options
                .Where(option => option.Text.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    option.Value.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToArray();
        }
    }

    private async Task ToggleAsync()
    {
        if (Disabled)
        {
            return;
        }

        isOpen = !isOpen;
        if (!isOpen)
        {
            search = string.Empty;
            return;
        }

        await InvokeAsync(StateHasChanged);
        await Task.Delay(1);
        try
        {
            await searchInput.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Panel may not be ready yet.
        }
    }

    private void OnSearch(ChangeEventArgs args) => search = args.Value?.ToString() ?? string.Empty;

    private async Task SelectAsync(string value)
    {
        Value = value;
        isOpen = false;
        search = string.Empty;
        await ValueChanged.InvokeAsync(value);
    }

    private void OnFocusIn() => retainFocus = true;

    private async Task OnFocusOutAsync()
    {
        retainFocus = false;
        await Task.Delay(180);
        if (retainFocus)
        {
            return;
        }

        isOpen = false;
        search = string.Empty;
    }
}
